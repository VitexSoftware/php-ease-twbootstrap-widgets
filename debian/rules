#!/usr/bin/make -f

PKG_PATH:=/usr/share/php/Ease
BUILD_DIR:=build

%:
	dh $@

override_dh_clean:
	rm -rf debian/test/vendor .phpdoc
	dh_clean

override_dh_prep:
	mkdir -p docs
	rm -f docs/* -r
	phpdoc -d src --title "Vitex Software's Ease Html"
	mkdir -p docs
	mv .phpdoc/build/* docs
	dh_prep


override_dh_auto_test:
	# Note: Tests may require dependencies. If needed, install them via debian/control Build-Depends
	# composer update removed - use phpab for autoloader generation
#	vendor/bin/phpunit --bootstrap tests/Bootstrap.php --configuration phpunit.xml tests/src/
#	dh_auto_test

override_dh_install:
	jq '.version = "'`dpkg-parsechangelog | sed -n 's/^Version: //p'| sed 's/~.*//'`'"'  debian/composer.json |sponge debian/composer.json
	dh_install
	# Static Debian autoloader (replaces the removed composer-global-update postinst step)
	install -D -m 0644 debian/autoload.php debian/php-vitexsoftware-ease-bootstrap-widgets/usr/share/php/EaseTWBWidgets/autoload.php
	install -m0755 -d debian/php-vitexsoftware-ease-bootstrap-widgets/usr/share/pkg-php-tools/autoloaders
	echo 'vitexsoftware ease-twbootstrap-widgets EaseTWBWidgets/autoload.php' > debian/php-vitexsoftware-ease-bootstrap-widgets/usr/share/pkg-php-tools/autoloaders/php-vitexsoftware-ease-bootstrap-widgets
	sed -e "/includeCss/c\        \$$this->includeCss(\'\/javascript\/bootstrap\/css\/bootstrap-switch.css\');" -i debian/php-vitexsoftware-ease-bootstrap-widgets/usr/share/php/EaseTWBWidgets/TWBSwitch.php
	sed -e "/includeJavascript/c\        \$$this->includeJavascript(\'\/javascript\/bootstrap\/js\/bootstrap-switch.js\');"   -i debian/php-vitexsoftware-ease-bootstrap-widgets/usr/share/php/EaseTWBWidgets/TWBSwitch.php 

